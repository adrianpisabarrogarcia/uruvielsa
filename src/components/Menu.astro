<script>
  // Detectar si estamos en la página principal o en otra página
  const isHomePage = window.location.pathname === '/';
  
  document.getElementById("menu-home").addEventListener("click", () => {
    if (isHomePage) {
      document.getElementById("home").scrollIntoView({ behavior: "smooth" });
    } else {
      window.location.href = "/";
    }
  });
  
  document.getElementById("menu-animation").addEventListener("click", () => {
    if (isHomePage) {
      document.getElementById("animation").scrollIntoView({ behavior: "smooth" });
    } else {
      window.location.href = "/#animation";
    }
  });
  
  document.getElementById("menu-artwork").addEventListener("click", () => {
    if (isHomePage) {
      document.getElementById("artwork").scrollIntoView({ behavior: "smooth" });
    } else {
      window.location.href = "/#artwork";
    }
  });
  
  document.getElementById("menu-contact").addEventListener("click", () => {
    if (isHomePage) {
      document.getElementById("contact").scrollIntoView({ behavior: "smooth" });
    } else {
      window.location.href = "/#contact";
    }
  });
  
  // Para el botón de diseño, si estamos en publicidad-voxel, hacer scroll interno
  const menuDesign = document.getElementById("menu-design");
  if (menuDesign) {
    menuDesign.addEventListener("click", () => {
      if (window.location.pathname === '/publicidad-voxel') {
        document.getElementById("publicidad-voxel").scrollIntoView({ behavior: "smooth" });
      } else if (isHomePage) {
        document.getElementById("design").scrollIntoView({ behavior: "smooth" });
      } else {
        window.location.href = "/publicidad-voxel";
      }
    });
  }
</script>

<nav
  class="font-bold text-sm md:sticky top-0 bg-white md:pt-5 md:pb-5 md:ps-5 md:pe-5 z-50"
>
  <ul class="flex flex-row justify-center flex-wrap">
    <li>
      <button
        id="menu-home"
        class="rounded py-2 px-4 hover:bg-yellow-personal-light2 hover:transition-all"
        >INICIO</button
      >
    </li>
    <li>
      <button
        id="menu-animation"
        class="rounded py-2 px-4 hover:bg-yellow-personal-light2 hover:transition-all"
        >ANIMACIÓN</button
      >
    </li>
    <li>
      <button
        id="menu-design"
        class="rounded py-2 px-4 hover:bg-yellow-personal-light2 hover:transition-all"
        >DISEÑO</button
      >
    </li>
    <li>
      <button
        id="menu-artwork"
        class="rounded py-2 px-4 hover:bg-yellow-personal-light2 hover:transition-all"
        >ILUSTRACIÓN</button
      >
    </li>
    <li>
      <button
        id="menu-contact"
        class="rounded py-2 px-4 hover:bg-yellow-personal-light2 hover:transition-all"
        >CONTACTO</button
      >
    </li>
  </ul>
</nav>
