---
import Layout from "../layouts/Layout.astro";
import Menu from "../components/Menu.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Publicidad Voxel - Uruvielsa">
  <Menu />
  
  <main class="container mx-auto px-4 py-8">
    <!-- Hero Section -->
    <section class="mb-12">
      <div class="bg-gradient-to-r from-cyan-400 to-purple-500 rounded-lg p-8 text-white">
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-4xl font-bold mb-4">VOXEL TRENDS</h1>
            <p class="text-xl">VOXEL TRENDS<br>VOXEL TRENDS</p>
          </div>
          <div class="text-right">
            <!-- Aquí irá la imagen del personaje -->
            <div class="w-64 h-64 bg-gray-300 rounded-lg flex items-center justify-center">
              <span class="text-gray-600">Imagen del personaje</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Publicidad Voxel Section -->
    <section id="publicidad-voxel" class="mb-12">
      <div class="grid md:grid-cols-2 gap-8 items-start">
        <div>
          <h2 class="text-3xl font-bold text-orange-500 mb-6">PUBLICIDAD<br>VOXEL</h2>
          
          <div class="space-y-4 text-gray-700">
            <p>
              Para promocionar todos los eventos que realiza Voxel School se realizan variaciones de formato del mismo contenido.
            </p>
            
            <p>
              Con las obras creadas por los alumnos se seleccionan trabajos que demuestren el resultado de la enseñanza.
            </p>
            
            <p>
              Se debe respetar los <strong>valores de la escuela y su marca</strong>, se modifica la imagen principal del evento o imágenes de los eventos.
            </p>
            
            <p>
              Las imágenes elegidas deben ser representativas del evento promocionado, necesitando previamente de un proceso de selección exhaustivo.
            </p>
          </div>
        </div>
        
        <div class="grid grid-cols-2 gap-4">
          <!-- Grid de imágenes promocionales -->
          <div class="bg-gray-300 h-32 rounded-lg flex items-center justify-center">
            <span class="text-gray-600 text-sm">Imagen 1</span>
          </div>
          <div class="bg-gray-300 h-32 rounded-lg flex items-center justify-center">
            <span class="text-gray-600 text-sm">Imagen 2</span>
          </div>
          <div class="bg-gray-300 h-32 rounded-lg flex items-center justify-center">
            <span class="text-gray-600 text-sm">Imagen 3</span>
          </div>
          <div class="bg-gray-300 h-32 rounded-lg flex items-center justify-center">
            <span class="text-gray-600 text-sm">Imagen 4</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Mobile Showcase Section -->
    <section class="mb-12 bg-cyan-500 py-12 -mx-4 px-4">
      <div class="container mx-auto">
        <div class="flex justify-center mb-8">
          <!-- Mockup de móvil -->
          <div class="relative">
            <div class="w-64 h-96 bg-black rounded-3xl p-4">
              <div class="w-full h-full bg-white rounded-2xl overflow-hidden">
                <!-- Contenido del móvil -->
                <div class="bg-gray-300 h-full flex items-center justify-center">
                  <span class="text-gray-600">Contenido móvil</span>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Carrusel de imágenes -->
        <div class="flex justify-center space-x-4 overflow-x-auto">
          <div class="flex-shrink-0 w-32 h-48 bg-gray-300 rounded-lg flex items-center justify-center">
            <span class="text-gray-600 text-xs">Img 1</span>
          </div>
          <div class="flex-shrink-0 w-32 h-48 bg-gray-300 rounded-lg flex items-center justify-center">
            <span class="text-gray-600 text-xs">Img 2</span>
          </div>
          <div class="flex-shrink-0 w-32 h-48 bg-gray-300 rounded-lg flex items-center justify-center">
            <span class="text-gray-600 text-xs">Img 3</span>
          </div>
          <div class="flex-shrink-0 w-32 h-48 bg-gray-300 rounded-lg flex items-center justify-center">
            <span class="text-gray-600 text-xs">Img 4</span>
          </div>
          <div class="flex-shrink-0 w-32 h-48 bg-gray-300 rounded-lg flex items-center justify-center">
            <span class="text-gray-600 text-xs">Img 5</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Adaptando Formatos Section -->
    <section class="mb-12">
      <div class="grid md:grid-cols-2 gap-8 items-center">
        <div class="space-y-4">
          <div class="bg-gray-300 h-48 rounded-lg flex items-center justify-center">
            <span class="text-gray-600">Imagen grande 1</span>
          </div>
          <div class="bg-gray-300 h-48 rounded-lg flex items-center justify-center">
            <span class="text-gray-600">Imagen grande 2</span>
          </div>
          <div class="bg-gray-300 h-48 rounded-lg flex items-center justify-center">
            <span class="text-gray-600">Imagen grande 3</span>
          </div>
        </div>
        
        <div>
          <h2 class="text-3xl font-bold text-gray-700 mb-6">Adaptando<br>formatos</h2>
          
          <div class="space-y-4 text-gray-700">
            <p>
              Las creatividades deben contener una <strong>imagen, fecha</strong> del evento y el contenido que se celebra (Voxel Trends, Master Class, Open House).
            </p>
            
            <p>
              Se debe mantener el <strong>horario y los ponentes</strong>. Para cada evento se debe crear un trabajo de los ponentes de la escuela que sea proporcional por los entornos que se realizan.
            </p>
            
            <p>
              Para cada evento se debe crear un trabajo de los ponentes de la escuela que sea proporcional por los entornos que se realizan. Dependiendo del formato, es necesario incorporar el logotipo de la escuela.
            </p>
            
            <p>
              Se debe mantener las historias de Instagram, al compartir espacio con la fotografía de perfil <strong>no es necesario que aparezca</strong>.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Promoción Digital Section -->
    <section class="mb-12">
      <div class="text-center mb-8">
        <p class="text-gray-700 max-w-4xl mx-auto">
          Para promocionar los eventos, Voxel School utiliza varios canales: <strong>correo electrónico</strong> 
          (para comunicarse con los alumnos de la escuela), <strong>redes sociales</strong> y su propia página <strong>web</strong>. 
          Para el mismo trabajo promocional, deben ser creadas <strong>historias y publicaciones de Instagram</strong> y 
          <strong>banners</strong>, suponiendo un reto mostrar el talento del alumnado junto con la información de forma clara y precisa.
        </p>
      </div>
      
      <!-- Laptop Mockup -->
      <div class="flex justify-center">
        <div class="w-96 h-64 bg-gray-800 rounded-lg p-4">
          <div class="w-full h-full bg-white rounded flex items-center justify-center">
            <span class="text-gray-600">Mockup de laptop</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Redes Sociales Section -->
    <section class="text-center py-8">
      <h3 class="text-xl font-bold text-gray-700 mb-4">REDES SOCIALES</h3>
      <div class="space-y-2 text-gray-600">
        <p>INSTAGRAM</p>
        <p>FACEBOOK</p>
        <p>YOUTUBE</p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>